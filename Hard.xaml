<Page x:Class="BattleShip.Hard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BattleShip"
        mc:Ignorable="d"
        Title="BattleShip">

    <Page.Resources>
        <!-- Shared Button Style -->
        <Style TargetType="Button" x:Key="GridButtonStyle">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Background" Value="#153F49"/>
            <Setter Property="BorderBrush" Value="#66C8D6D8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>

            <Style.Triggers>
                <!-- Hover glow -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E6F7A"/>
                    <Setter Property="BorderBrush" Value="#BFEAFF"/>
                </Trigger>

                <!-- Click effect -->
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0E3A42"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Label Style matching Button look -->
        <Style x:Key="MetalLabelStyle" TargetType="Label">
            <!-- SIZE (must match grid cells) -->
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>

            <!-- TEXT -->
            <Setter Property="FontFamily" Value="Castellar"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="#FF0F1A1D"/>

            <!-- ALIGNMENT -->
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <!-- CLEAN SPACING -->
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="1"/>

            <!-- BORDER -->
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#FF2C3E42"/>

            <!-- METAL LOOK -->
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFE0E0E0" Offset="0"/>
                        <GradientStop Color="#FFB0B8B8" Offset="0.5"/>
                        <GradientStop Color="#FF7A8686" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>

            <!-- SUBTLE SHADOW -->
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black"
                              BlurRadius="4"
                              ShadowDepth="1"
                              Opacity="0.4"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <Grid x:Name="GameGrid" Width="1562" Height="946">
        <Grid.Background>
            <ImageBrush ImageSource="/battlefield2.jpg" Stretch="Fill"/>
        </Grid.Background>

        <Border Margin="154,191,0,0"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        Width="508"
        Height="508"
        Background="#DD0B2D36"
        BorderBrush="#BFC8D6D8"
        BorderThickness="2">
            <UniformGrid x:Name="PlayerGrid"
                 Rows="10"
                 Columns="10"
                 Width="500"
                 Height="500"/>
        </Border>

        <Border Margin="860,191,0,0"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        Width="508"
        Height="508"
        Background="#DD0B2D36"
        BorderBrush="#BFC8D6D8"
        BorderThickness="2">
            <UniformGrid x:Name="EnemyGrid"
                 Rows="10"
                 Columns="10"
                 Width="500"
                 Height="500"/>
        </Border>

        <!--Grid settings-->
        <Label x:Name="Player" Content="PLAYER" HorizontalAlignment="Left" 
               Height="68" Margin="154,124,0,0" VerticalAlignment="Top" Width="240" 
               FontSize="52" FontWeight="Bold" FontFamily="Castellar" 
               Background="#FFA9B4B0" BorderBrush="#FF222B32" 
               Foreground="#FF262E36" OpacityMask="#FFD2B99B"/>
        <Label x:Name="Enemy" Content="ENEMY" HorizontalAlignment="Left" 
               Height="68" Margin="1152,124,0,0" VerticalAlignment="Top" Width="214" 
               FontSize="52" FontWeight="Bold" FontFamily="Castellar" 
               Background="#FFA9B4B0" BorderBrush="#FF222B32" 
               Foreground="#FF262E36" OpacityMask="#FFD2B99B"/>
        <Label x:Name="txtPlayerScore" Content="0" HorizontalAlignment="Left" 
               Margin="613,122,0,0" VerticalAlignment="Top" FontWeight="Bold" 
               FontSize="48" Background="#FFA9B4B0" Foreground="#FF262E36" FontFamily="Castellar" Height="64" Width="46"/>
        <Label x:Name="txtEnemyScore" Content="0" HorizontalAlignment="Left" 
               Margin="866,128,0,0" VerticalAlignment="Top" FontWeight="Bold" 
               FontSize="48" Background="#FFA9B4B0" Foreground="#FF262E36" FontFamily="Castellar" Height="64"/>
        <Border Background="#AA000000"
        BorderBrush="#BFC8D6D8"
        BorderThickness="2"
        CornerRadius="6"
        Padding="8"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        Margin="620,23,0,0"
        Height="63">

            <TextBlock x:Name="GameStatusText"
               Text="Place your ships!"
               Foreground="White"
               FontSize="26"
               FontWeight="Bold"
               HorizontalAlignment="Left"
               VerticalAlignment="Top" Margin="0,2,0,0">

                <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="StatusTextTransform" />
                </TextBlock.RenderTransform>

            </TextBlock>
        </Border>
        <Button  x:Name="back" Margin="-48,-27,1189,796" RenderTransformOrigin="0.5,0.5" Click="BackButton_Click">
            <Button.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="0.328"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Button.RenderTransform>
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent">
                        <Image Source="pack://application:,,,/BattleShip;component/back.png"/>

                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!--Ships-->
        <Border
            Width="166"
            Height="518"
            Background="#DD0B2D36"
            BorderBrush="#BFC8D6D8"
            BorderThickness="2"
            HorizontalAlignment="Left"
            VerticalAlignment="Top" Margin="679,192,0,0">
            <Border.Effect>
                <DropShadowEffect 
                Color="#88C8D6D8"
                BlurRadius="15"
                ShadowDepth="0"/>
            </Border.Effect>
            <StackPanel Orientation="Vertical" Margin="10,10,10,-66">
                <StackPanel.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Margin" Value="0,6"/>
                    </Style>
                </StackPanel.Resources>
                <TextBlock Text="YOUR FLEET"
                   Foreground="White"
                   FontWeight="Bold"
                   FontSize="18"
                   Margin="5"
                   HorizontalAlignment="Center"/>
                <!-- Carrier (5) -->
                <Button x:Name="CarrierBtn"
                Tag="Carrier:5"
                PreviewMouseMove="ShipDragStart"
                Background="#DD102B34"
                BorderBrush="#BFC8D6D8"
                BorderThickness="2">
                    <Grid>
                        <Image Source="pack://application:,,,/BattleShip;component/carrier.png"
                        Stretch="Uniform"
                        Height="60"/>
                        <TextBlock x:Name="CarrierCount"
                           Text="x1"
                           Foreground="White"
                           FontWeight="Bold"
                           Background="#80000000"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom"
                           Margin="3"/>
                    </Grid>
                </Button>
                <!-- Cruiser (3) -->
                <Button x:Name="CruiserBtn"
                Tag="Cruiser:3"
                PreviewMouseMove="ShipDragStart"
                Background="#DD102B34"
                BorderBrush="#BFC8D6D8"
                BorderThickness="2">
                    <Grid>
                        <Image Source="pack://application:,,,/BattleShip;component/cruiser.png"
                        Stretch="Uniform"
                        Height="60"/>
                        <TextBlock x:Name="CruiserCount"
                       Text="x2"
                       Foreground="White"
                       FontWeight="Bold"
                       Background="#80000000"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       Margin="3"/>
                    </Grid>
                </Button>
                <!-- Submarine (3) -->
                <Button x:Name="SubmarineBtn"
                Tag="Submarine:3"
                PreviewMouseMove="ShipDragStart"
                Background="#DD102B34"
                BorderBrush="#BFC8D6D8"
                BorderThickness="2">
                    <Grid>
                        <Image Source="pack://application:,,,/BattleShip;component/submarine.png"
                        Stretch="Uniform"
                        Height="60"/>
                        <TextBlock x:Name="SubmarineCount"
                           Text="x2"
                           Foreground="White"
                           FontWeight="Bold"
                           Background="#80000000"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom"
                           Margin="3"/>
                    </Grid>
                </Button>
                <!-- Battleship (2) -->
                <Button x:Name="BattleshipBtn"
                Tag="Battleship:2"
                PreviewMouseMove="ShipDragStart"
                Background="#DD102B34"
                BorderBrush="#BFC8D6D8"
                BorderThickness="2">
                    <Grid>
                        <Image Source="pack://application:,,,/BattleShip;component/battleship.png"
                         Stretch="Uniform"
                         Height="60"/>
                        <TextBlock x:Name="BattleshipCount"
                           Text="x2"
                           Foreground="White"
                           FontWeight="Bold"
                           Background="#80000000"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom"
                           Margin="3"/>
                    </Grid>
                </Button>
                <!-- Destroyer (1) -->
                <Button x:Name="DestroyerBtn"
                Tag="Destroyer:1"
                PreviewMouseMove="ShipDragStart"
                Background="#DD102B34"
                BorderBrush="#BFC8D6D8"
                BorderThickness="2">
                    <Grid>
                        <Image Source="pack://application:,,,/BattleShip;component/destroyer.png"
                        Stretch="Uniform"
                        Height="60"/>
                        <TextBlock x:Name="DestroyerCount"
                           Text="x4"
                           Foreground="White"
                           FontWeight="Bold"
                           Background="#80000000"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom"
                           Margin="3"/>
                    </Grid>
                </Button>
                <Button Content="⟳ ROTATE"
                    Click="RotateShipClick"
                    Height="58"
                    Background="#DD102B34"
                    BorderBrush="#BFC8D6D8"
                    BorderThickness="2"
                    Foreground="White"
                    FontWeight="Bold"/>
            </StackPanel>
        </Border>
        <Button Content="🔄"
        Click="Restart_Click"
        Width="108"
        Height="99"
        Margin="0,23,45,0"
        HorizontalAlignment="Right"
        VerticalAlignment="Top"
        Background="#DD102B34"
        BorderBrush="#BFC8D6D8"
        BorderThickness="2"
        Foreground="White"
        FontWeight="Bold"
        FontSize="40"/>
        <!-- Player side labels -->
        <Border
        Margin="104,197,0,0"
        Width="50"
        Height="500"
        Background="#DD0B2D36"
        BorderBrush="#BFC8D6D8"
        BorderThickness="2"
        HorizontalAlignment="Left"
        VerticalAlignment="Top">

            <StackPanel>
                <Label Content="A" Style="{StaticResource MetalLabelStyle}"/>
                <Label Content="B" Style="{StaticResource MetalLabelStyle}"/>
                <Label Content="C" Style="{StaticResource MetalLabelStyle}"/>
                <Label Content="D" Style="{StaticResource MetalLabelStyle}"/>
                <Label Content="E" Style="{StaticResource MetalLabelStyle}"/>
                <Label Content="F" Style="{StaticResource MetalLabelStyle}"/>
                <Label Content="G" Style="{StaticResource MetalLabelStyle}"/>
                <Label Content="H" Style="{StaticResource MetalLabelStyle}"/>
                <Label Content="I" Style="{StaticResource MetalLabelStyle}"/>
                <Label Content="J" Style="{StaticResource MetalLabelStyle}"/>
            </StackPanel>

        </Border>

        <!-- Bottom numbers -->
        <Border
        Margin="159,700,0,0"
        Width="500"
        Height="50"
        Background="#DD0B2D36"
        BorderBrush="#BFC8D6D8"
        BorderThickness="2"
        HorizontalAlignment="Left"
        VerticalAlignment="Top">

            <StackPanel Orientation="Horizontal">
                <Label Content="1" Style="{StaticResource MetalLabelStyle}"/>
                <Label Content="2" Style="{StaticResource MetalLabelStyle}"/>
                <Label Content="3" Style="{StaticResource MetalLabelStyle}"/>
                <Label Content="4" Style="{StaticResource MetalLabelStyle}"/>
                <Label Content="5" Style="{StaticResource MetalLabelStyle}"/>
                <Label Content="6" Style="{StaticResource MetalLabelStyle}"/>
                <Label Content="7" Style="{StaticResource MetalLabelStyle}"/>
                <Label Content="8" Style="{StaticResource MetalLabelStyle}"/>
                <Label Content="9" Style="{StaticResource MetalLabelStyle}"/>
                <Label Content="10" Style="{StaticResource MetalLabelStyle}"/>
            </StackPanel>

        </Border>
        <!-- Enemy vertical labels panel -->
        <Border
        Margin="1365,194,0,0"
        Width="50"
        Height="500"
        Background="#DD0B2D36"
        BorderBrush="#BFC8D6D8"
        BorderThickness="2"
        HorizontalAlignment="Left"
        VerticalAlignment="Top">

            <StackPanel>
                <Label Content="Q" Style="{StaticResource MetalLabelStyle}"/>
                <Label Content="R" Style="{StaticResource MetalLabelStyle}"/>
                <Label Content="S" Style="{StaticResource MetalLabelStyle}"/>
                <Label Content="T" Style="{StaticResource MetalLabelStyle}"/>
                <Label Content="U" Style="{StaticResource MetalLabelStyle}"/>
                <Label Content="V" Style="{StaticResource MetalLabelStyle}"/>
                <Label Content="W" Style="{StaticResource MetalLabelStyle}"/>
                <Label Content="X" Style="{StaticResource MetalLabelStyle}"/>
                <Label Content="Y" Style="{StaticResource MetalLabelStyle}"/>
                <Label Content="Z" Style="{StaticResource MetalLabelStyle}"/>
            </StackPanel>

        </Border>
        <!-- Enemy bottom numbers -->
        <Border
        Margin="866,700,0,0"
        Width="500"
        Height="50"
        Background="#DD0B2D36"
        BorderBrush="#BFC8D6D8"
        BorderThickness="2"
        HorizontalAlignment="Left"
        VerticalAlignment="Top">

            <StackPanel Orientation="Horizontal">
                <Label Content="1" Style="{StaticResource MetalLabelStyle}"/>
                <Label Content="2" Style="{StaticResource MetalLabelStyle}"/>
                <Label Content="3" Style="{StaticResource MetalLabelStyle}"/>
                <Label Content="4" Style="{StaticResource MetalLabelStyle}"/>
                <Label Content="5" Style="{StaticResource MetalLabelStyle}"/>
                <Label Content="6" Style="{StaticResource MetalLabelStyle}"/>
                <Label Content="7" Style="{StaticResource MetalLabelStyle}"/>
                <Label Content="8" Style="{StaticResource MetalLabelStyle}"/>
                <Label Content="9" Style="{StaticResource MetalLabelStyle}"/>
                <Label Content="10" Style="{StaticResource MetalLabelStyle}"/>
            </StackPanel>

        </Border>
    </Grid>

</Page> 


