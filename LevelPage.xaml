<Page x:Class="BattleShip.LevelPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BattleShip"
        mc:Ignorable="d"
        Title="BattleShip">
    <Viewbox Stretch="UniformToFill">
    <Grid x:Name="LevelGrid" Width="1500" Height="1000">
        <Grid.Background>
            <ImageBrush ImageSource="/warship2.jpg" Stretch="Fill"/>
        </Grid.Background>
        <Button  x:Name="easy" Margin="654,172,506,676" RenderTransformOrigin="0.5,0.5" Click="easy_Click">
            <Button.RenderTransform>
                <TranslateTransform x:Name="buttonTransform"/>
            </Button.RenderTransform>
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent">
                        <Image Source="pack://application:,,,/BattleShip;component/easy.png"/>

                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
        <Button  x:Name="medium" Margin="902,284,247,500" RenderTransformOrigin="0.5,0.5" Click="medium_Click">
            <Button.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="0.364"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Button.RenderTransform>
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent">
                        <Image Source="medium.png"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
            <Button  x:Name="hard" Margin="144,484,962,337" RenderTransformOrigin="0.5,0.5" Click="hard_Click">
                <Button.RenderTransform>
                    <TranslateTransform x:Name="buttonTransform3"/>
                </Button.RenderTransform>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <Image Source="hard.png"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
        </Viewbox>
</Page> 